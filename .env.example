# Public site URL (used for canonical URLs, sitemap and moderation links)
NEXT_PUBLIC_SITE_URL=https://natalybeautymassages.nl

# Cal.com username — event-type slugs must match the service slugs in src/content/services.ts
NEXT_PUBLIC_CAL_USERNAME=natalybeautymassages

# Supabase (EU region). Service-role key is server-only — never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — moderation emails for new reviews
RESEND_API_KEY=
RESEND_FROM_EMAIL="Nataly Beauty Massages <reviews@natalybeautymassages.nl>"
REVIEW_NOTIFY_EMAIL=natalypereyrav@gmail.com

# HMAC secret for the one-tap moderation links (min. 32 chars): openssl rand -base64 48
REVIEW_TOKEN_SECRET=

# Cloudflare Turnstile (spam protection on the review form). Required in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
